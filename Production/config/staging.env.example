# =====================================================================
# TrustSense-BMS: Staging Environment Runtime Configuration
# Non-conflicting isolated staging environment for release candidate validation.
# =====================================================================

NODE_ENV=production
PORT=3001
FRONTEND_URL=http://localhost:3010

# 1. Staging Database (Isolated credentials and database)
STAGING_POSTGRES_USER=eculytics_staging
STAGING_POSTGRES_PASSWORD=StagingSecretPass2026!
STAGING_POSTGRES_DB=eculytics_staging
DATABASE_URL=postgres://eculytics_staging:StagingSecretPass2026!@staging-postgres:5432/eculytics_staging

# 2. Virtual Thermal Sensor Microservice
THERMAL_AI_URL=http://staging-thermal-ai:8000

# 3. Cryptographic Authentication & RBAC
STAGING_JWT_SECRET=trustsense_staging_production_test_secret_key_marine_2026_at_least_32_chars
JWT_SECRET=trustsense_staging_production_test_secret_key_marine_2026_at_least_32_chars

# 4. Evidence Storage (AWS S3)
STORAGE_MODE=auto
AWS_REGION=ap-south-1
AWS_S3_BUCKET=trustsense-evidence-218733195047-ap-south-1
AWS_PROFILE=trustsense-restricted

# 5. Payment Gateway (Razorpay Test Mode)
RAZORPAY_KEY_ID=rzp_test_1DP5mmOlF5G5ag
RAZORPAY_KEY_SECRET=sD3lJp1vXv5V4J1bXv5V4J1b
RAZORPAY_WEBHOOK_SECRET=whsec_staging_test_secret_2026

# 6. Hyperledger Fabric Blockchain Consortium
FABRIC_ENABLED=true
FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL=bmschannel
FABRIC_CHAINCODE=trustsense-provenance
FABRIC_PEER_ENDPOINT=peer0.org1.example.com:7051
FABRIC_PEER_HOST_OVERRIDE=peer0.org1.example.com
FABRIC_TLS_CERT_PATH=/etc/fabric/crypto/ca.crt
FABRIC_USER_CERT_PATH=/etc/fabric/crypto/user.crt
FABRIC_USER_KEY_PATH=/etc/fabric/crypto/user.key
