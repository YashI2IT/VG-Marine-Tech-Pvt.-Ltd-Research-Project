# =====================================================================
# ECUlytics & TrustSense-BMS Enterprise Production Environment
# Security Notice: NEVER commit actual production secrets to source control.
# Copy this file to '.env.production' on production host and populate with
# securely generated credentials (e.g. from AWS Secrets Manager or HashiCorp Vault).
# =====================================================================

# ---------------------------------------------------------------------
# 1. Core Server Runtime
# ---------------------------------------------------------------------
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://eculytics.vgmarine.com

# ---------------------------------------------------------------------
# 2. Database Connection (PostgreSQL 16+)
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
# ---------------------------------------------------------------------
DATABASE_URL=postgres://eculytics_admin:REPLACE_WITH_SECURE_PASSWORD@postgres.internal:5432/eculytics_prod?sslmode=require

# ---------------------------------------------------------------------
# 3. Cryptographic Authentication & Session Security
# Generate using: openssl rand -hex 32 (min 32 characters required)
# ---------------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_OPENSSL_GENERATED_32_CHAR_HEX_SECRET
COOKIE_DOMAIN=.vgmarine.com
COOKIE_SECURE=true

# ---------------------------------------------------------------------
# 4. ML Virtual Thermal Sensor (CNN-LSTM Inference Microservice)
# ---------------------------------------------------------------------
THERMAL_AI_URL=http://thermal-inference:8000
PYTHON_ENV=production
MODEL_CACHE_DIR=/opt/eculytics/models

# ---------------------------------------------------------------------
# 5. AWS S3 Evidence Storage & Workload Role Authentication
# In production workloads (ECS Task Role / EC2 Instance Profile / EKS IRSA),
# do NOT set AWS_PROFILE, AWS_ACCESS_KEY_ID, or AWS_SECRET_ACCESS_KEY.
# The AWS SDK automatically inherits workload role credentials via IMDSv2.
# ---------------------------------------------------------------------
STORAGE_MODE=s3
AWS_REGION=ap-south-1
AWS_S3_BUCKET=trustsense-evidence-218733195047-ap-south-1

# ---------------------------------------------------------------------
# 6. Payment Gateway (Razorpay)
# Staging: rzp_test_* | Production Live: rzp_live_*
# Switch to Live only after merchant activation and bank settlement approval.
# ---------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_REPLACE_WITH_MERCHANT_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_MERCHANT_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET_CONFIGURED_IN_DASHBOARD

# ---------------------------------------------------------------------
# 7. Hyperledger Fabric Blockchain Consortium
# ---------------------------------------------------------------------
FABRIC_ENABLED=true
FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL=bmschannel
FABRIC_CHAINCODE=trustsense-provenance
FABRIC_PEER_ENDPOINT=peer0.org1.vgmarine.internal:7051
FABRIC_PEER_HOST_OVERRIDE=peer0.org1.vgmarine.internal
FABRIC_TLS_CERT_PATH=/etc/fabric/crypto/tlscacerts/tls-ca-cert.pem
FABRIC_USER_CERT_PATH=/etc/fabric/crypto/users/User1@org1.vgmarine.internal/msp/signcerts/cert.pem
FABRIC_USER_KEY_PATH=/etc/fabric/crypto/users/User1@org1.vgmarine.internal/msp/keystore/priv_sk

# ---------------------------------------------------------------------
# 8. Ingestion Security & API Rate Limiting
# ---------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
TELEMETRY_INGEST_TOKEN=REPLACE_WITH_STRONG_BMS_INGESTION_SECRET
TELEMETRY_TRANSPORT=http
