# Multi-Stage Production Build: Backend API Gateway
FROM node:20-alpine AS builder
WORKDIR /app
COPY Development/backend/package*.json ./
RUN npm ci
COPY Development/backend/ ./
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# Security: Non-root execution using built-in node user
COPY --chown=node:node Development/backend/package*.json ./
RUN npm ci --omit=dev

COPY --chown=node:node --from=builder /app/dist ./dist
COPY --chown=node:node --from=builder /app/data ./data

RUN mkdir -p /app/uploads /app/uploads/evidence && chown -R node:node /app/uploads

USER node

EXPOSE 3001
CMD ["node", "dist/index.js"]
