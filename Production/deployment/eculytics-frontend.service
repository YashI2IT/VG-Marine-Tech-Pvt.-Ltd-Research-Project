[Unit]
Description=ECUlytics & TrustSense-BMS Next.js Frontend App
After=network.target

[Service]
Type=simple
User=eculytics
WorkingDirectory=/opt/eculytics/Development/frontend
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
Environment=NODE_ENV=production PORT=3000

[Install]
WantedBy=multi-user.target
