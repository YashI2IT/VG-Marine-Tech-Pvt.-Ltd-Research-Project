# =====================================================================
# TrustSense-BMS: Environment Configuration Template
# =====================================================================

# 1. API Gateway & Port Configuration
PORT=3001
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change_me_to_a_long_random_string

# 2. PostgreSQL 16+ Database Connection
# Format: postgres://username:password@hostname:5432/database_name
DATABASE_URL=postgres://postgres:your_secure_password@localhost:5432/eculytics

# 3. Thermal AI Virtual Sensor Microservice (Python FastAPI + TensorFlow)
THERMAL_AI_URL=http://127.0.0.1:8000
TF_ENABLE_ONEDNN_OPTS=0

# 4. Hyperledger Fabric Blockchain Configuration
FABRIC_CHANNEL=bmschannel
FABRIC_CHAINCODE=trustsense-provenance
# If connecting to an external live Fabric peer, specify connection profile & identity:
# FABRIC_PEER_ENDPOINT=localhost:7051
# FABRIC_CCP_PATH=./config/connection-org1.json
# FABRIC_MSP_ID=Org1MSP

# 5. Cloud Storage (AWS S3) Configuration
# Default Region: ap-south-1 (Asia Pacific - Mumbai, India)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=trustsense-evidence-218733195047-ap-south-1
# STORAGE_MODE: "auto" (default: S3 with safe local fallback), "s3" (mandatory S3), "local" (filesystem only)
STORAGE_MODE=auto
# AWS CLI profile with dedicated least-privilege IAM role (preferred)
AWS_PROFILE=trustsense-restricted
# Leave blank to use AWS CLI profile / IAM role default credential provider chain (~/.aws/credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 6. Razorpay Payment Gateway (Test or Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# 7. Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# 7. Physical telemetry acquisition (read-only)
# TELEMETRY_TRANSPORT=http,mqtt,serial
TELEMETRY_TRANSPORT=http
TELEMETRY_DEVICE_ID=unassigned-bms
# Optional shared secret for HTTP ingest (never put this in the frontend)
TELEMETRY_INGEST_TOKEN=
TELEMETRY_STALE_MS=5000
TELEMETRY_FUTURE_SKEW_MS=2000
TELEMETRY_MAX_GAP_S=2
# payload = BMS must send ah. integrate = coulomb-count from TELEMETRY_AH_INITIAL
TELEMETRY_AH_SOURCE=payload
TELEMETRY_AH_INITIAL=0
MQTT_BROKER_URL=
MQTT_TOPIC=trustsense/bms/+/telemetry
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=trustsense-bms-gateway
TELEMETRY_SERIAL_PATH=
TELEMETRY_SERIAL_BAUD=115200
