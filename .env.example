# =====================================================================
# TrustSense-BMS: Environment Configuration Template
# =====================================================================

# 1. API Gateway & Port Configuration
PORT=3001
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change_me_to_a_long_random_string

# 2. PostgreSQL 16+ Database Connection
# Format: postgres://username:password@hostname:5432/database_name
DATABASE_URL=postgres://postgres:your_secure_password@localhost:5432/eculytics

# 3. Thermal AI Virtual Sensor Microservice (Python FastAPI + TensorFlow)
THERMAL_AI_URL=http://127.0.0.1:8000
TF_ENABLE_ONEDNN_OPTS=0

# 4. Hyperledger Fabric Blockchain Configuration
FABRIC_CHANNEL=bmschannel
FABRIC_CHAINCODE=trustsense-provenance
# If connecting to an external live Fabric peer, specify connection profile & identity:
# FABRIC_PEER_ENDPOINT=localhost:7051
# FABRIC_CCP_PATH=./config/connection-org1.json
# FABRIC_MSP_ID=Org1MSP

# 5. Cloud Storage (AWS S3) Configuration
# Default Region: ap-south-1 (Asia Pacific - Mumbai, India)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=trustsense-evidence-218733195047-ap-south-1
STORAGE_MODE=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 6. Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001

# 7. Physical telemetry (see Development/docs/TELEMETRY_CONTRACT.md)
TELEMETRY_TRANSPORT=http
TELEMETRY_DEVICE_ID=unassigned-bms
TELEMETRY_INGEST_TOKEN=
MQTT_BROKER_URL=
TELEMETRY_SERIAL_PATH=
